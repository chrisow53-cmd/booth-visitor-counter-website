# ==========================================
# Google Cloud Platform (GCP) Configuration
# ==========================================
# Storage provider: 'gcp' (production) or 'local' (offline local development)
STORAGE_PROVIDER=gcp

# Google Cloud Storage bucket name for CCTV snapshots & evidence images
GCS_BUCKET_NAME=cctv-snapshots

# Optional: GCP Project ID (auto-detected when running on GCP Cloud Run / App Engine)
GCP_PROJECT_ID=carching-visitor-tracker

# Optional: Custom domain / CDN URL for snapshots and API
BASE_URL=https://camera.carching.co

# For local testing with a GCP Service Account key file:
# GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# Alternatively, direct service account credentials from environment variables:
# GCP_CLIENT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com
# GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ==========================================
# Server Configuration
# ==========================================
PORT=3001
