# ==========================================
# Cloud Storage Provider Selection
# Options: 'gcp' or 'supabase' (defaults to 'gcp' if GCP credentials/bucket are provided)
# ==========================================
STORAGE_PROVIDER=gcp

# ------------------------------------------
# Google Cloud Platform (GCP) Configuration
# ------------------------------------------
# Google Cloud Storage bucket name for CCTV snapshots & evidence images
GCS_BUCKET_NAME=cctv-snapshots
# Optional: GCP Project ID (auto-detected when running on GCP Cloud Run / App Engine)
GCP_PROJECT_ID=your-gcp-project-id

# For local development or VMs outside GCP:
# Path to your downloaded GCP service account JSON key file:
# GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# Alternatively, direct service account credentials (useful for CI/CD or env variable injection):
# GCP_CLIENT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com
# GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: Custom public URL base (defaults to https://storage.googleapis.com/<bucket-name>)
# GCS_PUBLIC_URL_BASE=https://storage.googleapis.com/cctv-snapshots

# ------------------------------------------
# Supabase Configuration (Alternative Provider)
# ------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_STORAGE_BUCKET=cctv-snapshots

# ------------------------------------------
# Server Configuration
# ------------------------------------------
PORT=3001
# Public domain where the backend is hosted
BASE_URL=https://camera.carching.co
